#![enable(implicit_some)]
// Public example: every number here is invented for illustration.
CharacterFile(
    format_version: 1,
    character: Character(
        id: "sample",
        name: "Sample Fighter",
        body: Body(
            max_health: 1000,
            gravity: 0.5,
            ground_friction: 2.0,
            air_friction: 0.2,
            max_ground_speed: 12,
            max_air_speed: 9,
            max_fall_speed: 14,
            air_actions: 1,
            collision_box: Rect(x: 0, y: -14, half_w: 12, half_h: 14),
            hurtbox: Rect(x: 0, y: -16, half_w: 14, half_h: 16),
        ),
        // Optional: stances. Moves list the modes they work in and may switch mode.
        modes: ["normal", "staff"],
        moves: [
            Move(
                id: "draw_staff",
                name: "Draw Staff",
                tags: ["grounded", "special"],
                stance: Ground,
                input: Input(button: Special, direction: Back),
                modes: ["normal"],
                set_mode: "staff",
                timeline: Timeline(startup: 0, active: 0, recovery: 14),
            ),
            Move(
                id: "light_jab",
                name: "Light Jab",
                tags: ["grounded", "attack", "light"],
                stance: Ground,
                input: Input(button: Light),
                timeline: Timeline(startup: 5, active: 2, recovery: 9),
                hitboxes: [
                    HitBox(
                        id: "fist",
                        rect: Rect(x: 18, y: -24, half_w: 14, half_h: 8),
                        window: Span(from: 6, to: 7),
                        damage: 30,
                        hitstun: 14,
                        hitlag: Hitlag(attacker: 4, victim: 4),
                        knockback: Knockback(dir: (1.0, -0.5), strength: 2.5),
                        height: Mid,
                        block_advantage: 1,
                    ),
                ],
                physics: Physics(friction: true, forces: true),
                motion: [MotionEvent(at: 1, kind: Impulse(forward: 2.0, up: 0.0))],
                cancels: [
                    Cancel(
                        into: ["grounded", "special"],
                        when: OnHitOrBlock,
                        window: Span(from: 6, to: 16),
                    ),
                ],
                presentation: Presentation(anim: "jab"),
            ),
            // A projectile move: no hitbox of its own, the orb carries the hit data.
            Move(
                id: "orb_shot",
                name: "Orb Shot",
                tags: ["grounded", "special"],
                stance: Ground,
                input: Input(button: Special, direction: Neutral),
                timeline: Timeline(startup: 0, active: 0, recovery: 22),
                spawns: [Spawn(at: 8, projectile: "orb", offset: (24, -22))],
            ),
            // An open-ended air move: runs until landing, hitbox stays live until the end.
            Move(
                id: "dive",
                name: "Dive",
                tags: ["aerial", "attack"],
                stance: Air,
                input: Input(button: Heavy, direction: Down),
                timeline: Timeline(startup: 10, active: 4, recovery: 0, end: OnLanding),
                hitboxes: [
                    HitBox(
                        id: "feet",
                        rect: Rect(x: 8, y: -4, half_w: 12, half_h: 10),
                        window: Span(from: 11, to: 14),
                        until_end: true,
                        damage: 55,
                        hitstun: 18,
                        hitlag: Hitlag(attacker: 5, victim: 8),
                        knockback: Knockback(dir: (1.0, 0.3), strength: 6),
                        height: High,
                    ),
                ],
                hurt: [HurtWindow(window: Span(from: 1, to: 10), rect: Rect(x: 0, y: -12, half_w: 12, half_h: 12))],
                physics: Physics(
                    gravity: true,
                    forces: true,
                    uncapped_forces: true,
                    gravity_override: GravityOverride(gravity: 0.6, fall_speed: 12),
                    speed_caps: SpeedCaps(ground: 10, air: 12),
                    friction_x: 0.05,
                ),
                motion: [MotionEvent(at: 1, kind: StopVertical)],
                cost: Cost(air_action: true),
            ),
            // A throw: the grab box hands over to a second move that is never entered by input.
            Move(
                id: "grab",
                name: "Grab",
                tags: ["grounded", "grab"],
                stance: Ground,
                input: Input(button: Grab),
                timeline: Timeline(startup: 3, active: 3, recovery: 10),
                hitboxes: [
                    HitBox(
                        id: "hands",
                        rect: Rect(x: 12, y: -18, half_w: 9, half_h: 12),
                        window: Span(from: 4, to: 6),
                        throw_into: "toss_throw",
                        damage: 0,
                        hitstun: 30,
                        hitlag: Hitlag(attacker: 0, victim: 0),
                        knockback: Knockback(dir: (1.0, 0.0), strength: 0),
                        height: Mid,
                        scaling: Scaling(counts_as_hit: false),
                        reaction: Reaction(grounded: Held, aerial: Held),
                        effects: Effects(throw: true),
                    ),
                ],
            ),
            Move(
                id: "toss_throw",
                name: "Toss",
                stance: Ground,
                timeline: Timeline(startup: 6, active: 1, recovery: 18),
                throw: Throw(
                    hold: (14, -12),
                    keyframes: [
                        HoldKey(at: 3, offset: (18, -14)),
                        HoldKey(at: 6, offset: (26, -8)),
                    ],
                    release: Release(
                        at: 8,
                        offset: (20, 0),
                        hit: ReleaseHit(
                            damage: 0,
                            hitstun: 22,
                            knockback: Knockback(dir: (1.0, -0.4), strength: 9),
                            scaling: Scaling(proration: 2),
                            effects: Effects(knockdown: Soft, stun_until_landing: false),
                            reaction: Reaction(grounded: Launch),
                            di_modifier: 1.5,
                        ),
                    ),
                ),
                hitboxes: [
                    HitBox(
                        id: "toss",
                        kind: ThrowDamage,
                        rect: Rect(x: 14, y: -20, half_w: 16, half_h: 12),
                        window: Span(from: 7, to: 7),
                        damage: 90,
                        hitstun: 24,
                        hitlag: Hitlag(attacker: 6, victim: 6),
                        knockback: Knockback(dir: (1.0, -0.4), strength: 9),
                        height: Mid,
                    ),
                ],
            ),
            // A move that takes a choice of every kind. Bindings say how a controller supplies them;
            // an unbound parameter (here `style`) simply uses its default.
            Move(
                id: "charge_shot",
                name: "Charge Shot",
                tags: ["grounded", "special"],
                stance: Ground,
                input: Input(button: Special, direction: Forward, hold: true),
                params: [
                    Param(
                        name: "aim",
                        kind: Direction(steps: Free, arc: Arc(center_deg: 0.0, range_deg: 90.0), default: (1.0, 0.0)),
                        binding: Stick,
                    ),
                    Param(
                        name: "facing",
                        kind: Direction(steps: Eight, allowed: [Forward, Back], default: (1.0, 0.0)),
                    ),
                    Param(name: "power", kind: Slider(min: 0, max: 100, default: 50), binding: Hold(max_ticks: 30)),
                    Param(name: "heavy", kind: Toggle(default: false), binding: Button(Heavy)),
                    Param(name: "style", kind: Choice(options: ["quick", "wide"], default: "quick")),
                    Param(name: "shots", kind: Count(min: 1, max: 3, default: 1)),
                ],
                timeline: Timeline(startup: 0, active: 0, recovery: 20),
                behavior: "sample.charge_shot",
            ),
            // Multi-hit sweep that is only available during a combo.
            Move(
                id: "spin_finisher",
                name: "Spin Finisher",
                tags: ["grounded", "super"],
                stance: Ground,
                input: Input(button: Super),
                availability: Availability(combo_only: true),
                timeline: Timeline(startup: 6, active: 8, recovery: 14),
                hitboxes: [
                    HitBox(
                        id: "sweep",
                        rect: Rect(x: 10, y: -16, half_w: 22, half_h: 14),
                        window: Span(from: 7, to: 14),
                        repeat: Repeat(active: 2, inactive: 1),
                        damage: 25,
                        hitstun: 16,
                        hitlag: Hitlag(attacker: 3, victim: 3),
                        knockback: Knockback(dir: (0.2, -1.0), strength: 3, reversible: true, from: TowardHitbox),
                        height: Mid,
                        min_damage: 10,
                        effects: Effects(air_ground_bounce: true),
                        followup: "toss_throw",
                    ),
                ],
                cost: Cost(super_bars: 1),
            ),
        ],
        projectiles: [
            Projectile(
                id: "orb",
                velocity: (6.0, 0.0),
                lifetime: 90,
                hitboxes: [
                    HitBox(
                        id: "body",
                        rect: Rect(x: 0, y: 0, half_w: 10, half_h: 10),
                        window: Span(from: 1, to: 90),
                        until_end: true,
                        damage: 40,
                        hitstun: 16,
                        hitlag: Hitlag(attacker: 3, victim: 6),
                        knockback: Knockback(dir: (1.0, -0.2), strength: 4),
                        height: Mid,
                    ),
                ],
            ),
        ],
    ),
)
